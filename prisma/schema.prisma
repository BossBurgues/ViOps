generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UnitType {
  CENTRAL_FABRICA
  OTICA
}

enum UserRole {
  ADMIN
  GESTOR
  VENDEDOR
  OPERADOR
  FINANCEIRO
}

enum ServiceOrderStatus {
  ABERTA
  ENVIADA_CENTRAL
  RECEBIDA
  PRODUCAO
  PENDENCIA
  PRONTA
  ENVIADA
  ENVIADA_UNIDADE
  ENTREGUE
  CANCELADA
}

enum SaleOrigin {
  OTICA
  EXTERNA
}

enum OperationalChannel {
  LOJA
  EXTERNA
  CENTRAL
}

enum StockCategory {
  ARMACAO
  LENTE
  ACESSORIO
  SOLUCAO
  EMBALAGEM
  OUTRO
}

enum StockMovementType {
  ENTRADA
  SAIDA
  BAIXA_OS
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  DEVOLUCAO
  TRANSFERENCIA
}

enum StockReservationStatus {
  ACTIVE
  CONSUMED
  CANCELLED
  EXPIRED
}

enum StockTransferStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

enum InventoryCountStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum FinancialProviderType {
  BANK
  GATEWAY
  ACQUIRER
  MANUAL
  OTHER
}

enum ChargeType {
  BOLETO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  DINHEIRO
  CHEQUE
  LINK_PAGAMENTO
  QR_CODE
  OUTRO
}

enum ChargeStatus {
  DRAFT
  GENERATED
  SENT
  PENDING
  PAID
  OVERDUE
  EXPIRED
  CANCELLED
  FAILED
}

enum PaymentMethod {
  PIX
  DINHEIRO
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
  CHEQUE
  LINK_PAGAMENTO
  QR_CODE
}

enum InstallmentStatus {
  PENDENTE
  PAGA
  VENCIDA
  CANCELADA
}

enum DocumentCategory {
  RECEITA
  GUIA_MEDICA
  LAUDO
  COMPROVANTE
  DOCUMENTO_CLIENTE
  OUTRO
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  STOCK_MOVEMENT
  STOCK_RESERVATION
  PAYMENT_EVENT
  LOGIN
  OTHER
}

model Tenant {
  id           String   @id @default(cuid())
  name         String
  legalName    String?
  document     String?  @unique
  stockEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  units              Unit[]
  users              User[]
  clients            Client[]
  serviceOrders      ServiceOrder[]
  financialProviders FinancialProvider[]
  charges            Charge[]
  stockItems         StockItem[]
  stockMovements     StockMovement[]
  stockReservations  StockReservation[]
  stockTransfers     StockTransfer[]
  inventoryCounts    InventoryCount[]
  auditLogs          AuditLog[]

  @@index([createdAt])
}

model Unit {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  type      UnitType @default(OTICA)
  city      String
  state     String
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                User[]
  serviceOrders        ServiceOrder[]
  stockItems           StockItem[]
  stockMovements       StockMovement[]
  reservations         StockReservation[]
  transfersOrigin      StockTransfer[]    @relation("TransferOrigin")
  transfersDestination StockTransfer[]    @relation("TransferDestination")
  inventoryCounts      InventoryCount[]

  @@index([tenantId])
  @@index([type])
  @@index([active])
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  unitId    String?
  name      String
  email     String
  role      UserRole
  active    Boolean  @default(true)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit           Unit?           @relation(fields: [unitId], references: [id])
  stockMovements StockMovement[]
  auditLogs      AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([unitId])
  @@index([role])
}

model Client {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  document  String?
  phone     String?
  email     String?
  city      String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceOrders ServiceOrder[]
  charges       Charge[]

  @@index([tenantId])
  @@index([document])
  @@index([createdAt])
}

model ServiceOrder {
  id                 String             @id @default(cuid())
  tenantId           String
  clientId           String
  unitId             String
  number             String
  status             ServiceOrderStatus @default(ABERTA)
  saleOrigin         SaleOrigin
  operationalChannel OperationalChannel
  sellerId           String?
  sellerName         String
  externalSellerName String?
  totalAmount        Decimal            @db.Decimal(12, 2)
  notes              String?
  priority           String?
  createdAt          DateTime           @default(now())
  expectedAt         DateTime?
  deliveredAt        DateTime?
  updatedAt          DateTime           @updatedAt

  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client             Client                 @relation(fields: [clientId], references: [id])
  unit               Unit                   @relation(fields: [unitId], references: [id])
  items              ServiceOrderItem[]
  documents          ServiceOrderDocument[]
  externalActionData ExternalActionData?
  factoryRef         FactoryRef?
  histories          ServiceOrderHistory[]
  charges            Charge[]
  payments           Payment[]
  installments       Installment[]
  stockMovements     StockMovement[]
  stockReservations  StockReservation[]
  auditLogs          AuditLog[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([clientId])
  @@index([unitId])
  @@index([status])
  @@index([createdAt])
}

model ServiceOrderItem {
  id             String   @id @default(cuid())
  serviceOrderId String
  stockItemId    String?
  description    String
  type           String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  serviceOrder      ServiceOrder       @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  stockItem         StockItem?         @relation(fields: [stockItemId], references: [id])
  stockMovements    StockMovement[]
  stockReservations StockReservation[]

  @@index([serviceOrderId])
  @@index([stockItemId])
}

model ServiceOrderDocument {
  id             String           @id @default(cuid())
  serviceOrderId String
  name           String
  mimeType       String
  sizeBytes      Int?
  category       DocumentCategory
  storageKey     String?
  uploadedByName String?
  createdAt      DateTime         @default(now())

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@index([category])
  @@index([createdAt])
}

model ExternalActionData {
  id                 String    @id @default(cuid())
  serviceOrderId     String    @unique
  locationName       String?
  postalCode         String?
  street             String?
  number             String?
  complement         String?
  district           String?
  city               String?
  state              String?
  referencePoint     String?
  localResponsible   String?
  contactPhone       String?
  externalSellerTeam String?
  actionDate         DateTime?
  notes              String?

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
}

model FactoryRef {
  id                     String    @id @default(cuid())
  serviceOrderId         String    @unique
  externalId             String?
  batch                  String?
  calctoolRxId           String?
  calctoolRxRegisteredAt DateTime?
  externalSystemId       String?
  externalSystemName     String?
  externalWriteOffDone   Boolean   @default(false)
  externalWriteOffAt     DateTime?
  productionStatus       String?
  factoryPriority        String?
  sentToFactoryAt        DateTime?
  returnedFromFactoryAt  DateTime?
  notes                  String?
  history                Json?

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([externalId])
  @@index([batch])
}

model ServiceOrderHistory {
  id             String             @id @default(cuid())
  serviceOrderId String
  status         ServiceOrderStatus
  description    String
  userName       String
  userId         String?
  createdAt      DateTime           @default(now())

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@index([status])
  @@index([createdAt])
}

model FinancialProvider {
  id        String                @id @default(cuid())
  tenantId  String
  name      String
  type      FinancialProviderType
  active    Boolean               @default(true)
  metadata  Json?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charges Charge[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([type])
}

model Charge {
  id             String       @id @default(cuid())
  tenantId       String
  serviceOrderId String
  clientId       String
  providerId     String?
  type           ChargeType
  status         ChargeStatus @default(DRAFT)
  amount         Decimal      @db.Decimal(12, 2)
  dueDate        DateTime?
  externalId     String?
  reference      String?
  url            String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceOrder ServiceOrder       @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  client       Client             @relation(fields: [clientId], references: [id])
  provider     FinancialProvider? @relation(fields: [providerId], references: [id])
  payments     Payment[]

  @@index([tenantId])
  @@index([serviceOrderId])
  @@index([clientId])
  @@index([providerId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
}

model Payment {
  id             String        @id @default(cuid())
  serviceOrderId String
  chargeId       String?
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  paidAt         DateTime?
  reference      String?
  notes          String?
  createdAt      DateTime      @default(now())

  serviceOrder ServiceOrder  @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  charge       Charge?       @relation(fields: [chargeId], references: [id])
  installments Installment[]

  @@index([serviceOrderId])
  @@index([chargeId])
  @@index([paidAt])
}

model Installment {
  id             String            @id @default(cuid())
  serviceOrderId String
  paymentId      String?
  number         Int
  amount         Decimal           @db.Decimal(12, 2)
  dueDate        DateTime
  status         InstallmentStatus @default(PENDENTE)
  method         PaymentMethod?
  paidAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  payment      Payment?     @relation(fields: [paymentId], references: [id])

  @@index([serviceOrderId])
  @@index([paymentId])
  @@index([status])
  @@index([dueDate])
}

model StockItem {
  id          String        @id @default(cuid())
  tenantId    String
  unitId      String
  name        String
  description String?
  category    StockCategory
  brand       String?
  reference   String?
  currentQty  Decimal       @default(0) @db.Decimal(12, 3)
  minimumQty  Decimal       @default(0) @db.Decimal(12, 3)
  costPrice   Decimal?      @db.Decimal(12, 2)
  salePrice   Decimal?      @db.Decimal(12, 2)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit                Unit                 @relation(fields: [unitId], references: [id])
  serviceOrderItems   ServiceOrderItem[]
  stockMovements      StockMovement[]
  reservations        StockReservation[]
  transferItems       StockTransferItem[]
  inventoryCountItems InventoryCountItem[]

  @@unique([tenantId, unitId, reference])
  @@index([tenantId])
  @@index([unitId])
  @@index([category])
  @@index([active])
}

model StockMovement {
  id                 String            @id @default(cuid())
  tenantId           String
  unitId             String
  stockItemId        String
  serviceOrderId     String?
  serviceOrderItemId String?
  userId             String?
  type               StockMovementType
  quantity           Decimal           @db.Decimal(12, 3)
  note               String?
  occurredAt         DateTime          @default(now())
  createdAt          DateTime          @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit             Unit              @relation(fields: [unitId], references: [id])
  stockItem        StockItem         @relation(fields: [stockItemId], references: [id])
  serviceOrder     ServiceOrder?     @relation(fields: [serviceOrderId], references: [id])
  serviceOrderItem ServiceOrderItem? @relation(fields: [serviceOrderItemId], references: [id])
  user             User?             @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([stockItemId])
  @@index([serviceOrderId])
  @@index([serviceOrderItemId])
  @@index([type])
  @@index([occurredAt])
}

model StockReservation {
  id                 String                 @id @default(cuid())
  tenantId           String
  unitId             String
  stockItemId        String
  serviceOrderId     String
  serviceOrderItemId String
  quantity           Decimal                @db.Decimal(12, 3)
  status             StockReservationStatus @default(ACTIVE)
  reservedAt         DateTime               @default(now())
  releasedAt         DateTime?
  consumedAt         DateTime?

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit             Unit             @relation(fields: [unitId], references: [id])
  stockItem        StockItem        @relation(fields: [stockItemId], references: [id])
  serviceOrder     ServiceOrder     @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  serviceOrderItem ServiceOrderItem @relation(fields: [serviceOrderItemId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([stockItemId])
  @@index([serviceOrderId])
  @@index([serviceOrderItemId])
  @@index([status])
}

model StockTransfer {
  id                String              @id @default(cuid())
  tenantId          String
  originUnitId      String
  destinationUnitId String
  status            StockTransferStatus @default(DRAFT)
  requestedById     String?
  shippedById       String?
  receivedById      String?
  shippedAt         DateTime?
  receivedAt        DateTime?
  note              String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  originUnit      Unit                @relation("TransferOrigin", fields: [originUnitId], references: [id])
  destinationUnit Unit                @relation("TransferDestination", fields: [destinationUnitId], references: [id])
  items           StockTransferItem[]

  @@index([tenantId])
  @@index([originUnitId])
  @@index([destinationUnitId])
  @@index([status])
  @@index([createdAt])
}

model StockTransferItem {
  id              String   @id @default(cuid())
  stockTransferId String
  stockItemId     String
  requestedQty    Decimal  @db.Decimal(12, 3)
  shippedQty      Decimal? @db.Decimal(12, 3)
  receivedQty     Decimal? @db.Decimal(12, 3)

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  stockItem     StockItem     @relation(fields: [stockItemId], references: [id])

  @@index([stockTransferId])
  @@index([stockItemId])
}

model InventoryCount {
  id         String               @id @default(cuid())
  tenantId   String
  unitId     String
  status     InventoryCountStatus @default(OPEN)
  openedById String?
  closedById String?
  openedAt   DateTime             @default(now())
  closedAt   DateTime?
  notes      String?

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit   Unit                 @relation(fields: [unitId], references: [id])
  items  InventoryCountItem[]

  @@index([tenantId])
  @@index([unitId])
  @@index([status])
  @@index([openedAt])
}

model InventoryCountItem {
  id               String  @id @default(cuid())
  inventoryCountId String
  stockItemId      String
  systemQty        Decimal @db.Decimal(12, 3)
  countedQty       Decimal @db.Decimal(12, 3)
  differenceQty    Decimal @db.Decimal(12, 3)
  note             String?

  inventoryCount InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  stockItem      StockItem      @relation(fields: [stockItemId], references: [id])

  @@index([inventoryCountId])
  @@index([stockItemId])
}

model AuditLog {
  id             String      @id @default(cuid())
  tenantId       String
  userId         String?
  serviceOrderId String?
  action         AuditAction
  resource       String
  resourceId     String?
  description    String
  metadata       Json?
  createdAt      DateTime    @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])
  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([serviceOrderId])
  @@index([action])
  @@index([createdAt])
}
